# DemandRadar Environment Variables
# Placeholder file - Do not commit real keys here

# AI Provider API Key (e.g. OpenAI, Anthropic, or custom)
# AI_API_KEY=

# Geocoding Service API Key (e.g. Mapbox, Google Maps)
# MAP_API_KEY=

# Database Connection String
# DB_URL=

# Map rendering provider
# Options: svg, mappls
# Default: svg. Mappls is reserved for a future provider-backed renderer layer.
VITE_DEMANDRADAR_MAP_PROVIDER=svg

# Mappls Web SDK public browser key/token
# Use only a domain-restricted browser-safe key/token.
# Never place a Mappls client_secret in frontend env files.
# VITE_MAPPLS_MAP_KEY=
